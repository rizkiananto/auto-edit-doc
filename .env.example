# Telegram bot token from @BotFather
BOT_TOKEN=
# ID of the Google Doc to edit (the long string in the doc URL)
DOC_ID=
# Comma-separated Telegram user IDs allowed to use the bot
ALLOWED_IDS=
# Optional: set to "off" to stop auto-updating the date line
# AUTO_DATE=off
# Only for test.ts: a COPY of the doc, never the real one
# TEST_DOC_ID=
